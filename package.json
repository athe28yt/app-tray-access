{
  "name": "shortcut-tray",
  "version": "1.1.8",
  "description": "Tray app for managing shortcuts",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release:patch": "npm version patch -m \"release %s\" && git push origin HEAD --follow-tags",
    "release:minor": "npm version minor -m \"release %s\" && git push origin HEAD --follow-tags",
    "release:major": "npm version major -m \"release %s\" && git push origin HEAD --follow-tags"
  },
  "devDependencies": {
    "electron": "40.6.1",
    "electron-builder": "26.8.1"
  },
  "dependencies": {
    "electron-updater": "6.8.3"
  },
  "build": {
    "appId": "com.shortcut.tray",
    "productName": "shortcut-tray",
    "icon": "build/icon.ico",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ]
  }
}
